{
  "id": "veinminer",
  "user": "Builder",
  "out_prop": "veinminer.selftest",
  "props": {
    "veinminer.selftest.mode": "{mode}",
    "veinminer.selftest.scene": "{scene}"
  },
  "defaults": {
    "mode": "full",
    "scene": "all"
  },
  "fabric_api": true,
  "width": 1280,
  "height": 720,
  "timeout": 900,
  "options": {
    "fps": 60,
    "volume": 0.0,
    "render_distance": 6
  },
  "tiers": {
    "quick": {
      "unit": [],
      "jobs": [
        {
          "mc": "26.3",
          "loader": "fabric"
        }
      ]
    },
    "full": {
      "unit": [
        ":26.3-fabric:test"
      ],
      "jobs": [
        {
          "mc": "26.3",
          "loader": "fabric"
        },
        {
          "mc": "26.2",
          "loader": "fabric"
        },
        {
          "mc": [
            "1.21.1",
            "1.20.1"
          ],
          "loader": "fabric",
          "scenes": "smoke"
        },
        {
          "mc": [
            "26.3",
            "26.2",
            "1.21.1",
            "1.20.1"
          ],
          "loader": [
            "neoforge",
            "forge"
          ],
          "scenes": "smoke"
        }
      ],
      "mp": [
        "join",
        "veinminer"
      ]
    },
    "release": {
      "unit": [
        ":26.3-fabric:test"
      ],
      "jobs": [
        {
          "mc": "26.3",
          "loader": "fabric"
        },
        {
          "mc": "26.2",
          "loader": "fabric"
        },
        {
          "mc": [
            "1.21.1",
            "1.20.1"
          ],
          "loader": "fabric",
          "scenes": "smoke"
        },
        {
          "mc": [
            "26.3",
            "26.2",
            "1.21.1",
            "1.20.1"
          ],
          "loader": [
            "neoforge",
            "forge"
          ],
          "scenes": "smoke"
        }
      ],
      "mp": [
        "join",
        "veinminer"
      ]
    }
  },
  "addons": {
    "fa": {
      "profile": {
        "26.3": "Fabric 26.3"
      },
      "mods": [
        "entity_model_features-*.jar",
        "entity_texture_features-*.jar"
      ],
      "packs": [
        "FreshAnimations_*.zip",
        "FA+Player-*.zip"
      ]
    }
  },
  "mp": {
    "cases": {
      "join": {
        "clients": [
          {
            "user": "Host",
            "role": "host",
            "seconds": 60
          },
          {
            "user": "Guest",
            "role": "guest",
            "seconds": 60,
            "after": "Host joined the game"
          }
        ],
        "steps": [
          {
            "wait": "Host joined the game",
            "timeout": 240
          },
          {
            "wait": "Guest joined the game",
            "timeout": 240
          }
        ]
      },
      "veinminer": {
        "clients": [
          {
            "user": "Host",
            "role": "host",
            "vars": {
              "mode": "mp-host"
            },
            "seconds": 150
          },
          {
            "user": "Guest",
            "role": "guest",
            "seconds": 60,
            "after": "Host joined the game"
          }
        ],
        "steps": [
          {
            "wait": "Host joined the game",
            "timeout": 300,
            "send": [
              "op Host",
              "gamemode survival Host",
              "gamerule spawn_mobs false",
              "effect give Host haste infinite 127 true",
              "give Host minecraft:iron_pickaxe",
              "fill 3 -60 2 6 -57 5 minecraft:coal_ore",
              "tp Host 4.5 -60 0.5 0 0",
              "veinminer set require_sneak false",
              "veinminer set animation true",
              "veinminer set max_blocks 64"
            ]
          },
          {
            "wait": "Guest joined the game",
            "timeout": 300,
            "send": [
              "gamemode survival Guest",
              "tp Guest 4.5 -60 -3.5 0 0"
            ]
          },
          {
            "name": "host_vein_done",
            "wait": "vein done",
            "timeout": 400
          },
          {
            "name": "blob_gone",
            "test": "execute unless block 4 -58 4 minecraft:coal_ore"
          },
          {
            "name": "no_displays",
            "test": "execute unless entity @e[type=minecraft:block_display]"
          },
          {
            "name": "loot_landed",
            "test": "execute if entity @e[type=minecraft:item,nbt={Item:{id:\"minecraft:coal\"}}]"
          }
        ],
        "checks": [
          {
            "name": "no_kicks",
            "absent": "(was kicked|Disconnecting|lost connection: (?!Disconnected))"
          },
          {
            "name": "no_veinminer_errors",
            "absent": "Veinminer: (chain|a vein) failed"
          }
        ]
      }
    }
  }
}
