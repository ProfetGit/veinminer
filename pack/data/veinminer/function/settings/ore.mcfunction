$execute if score #ore.$(key) veinminer.config matches 1 run return run data modify storage veinminer:menu row append value {text:"$(label)",color:"green",hover_event:{action:"show_text",value:"Enabled – click to disable"},click_event:{action:"run_command",command:"/function veinminer:settings/set {key:ore.$(key),value:0}"}}
$data modify storage veinminer:menu row append value {text:"$(label)",color:"red",strikethrough:true,hover_event:{action:"show_text",value:"Disabled – click to enable"},click_event:{action:"run_command",command:"/function veinminer:settings/set {key:ore.$(key),value:1}"}}
