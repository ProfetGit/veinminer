$execute if score #$(key) veinminer.config matches 1 run return run tellraw @s ["",{text:" $(label): ",color:"gray",hover_event:{action:"show_text",value:"$(hint)"}},{text:"[ON]",color:"green",hover_event:{action:"show_text",value:"Click to turn off"},click_event:{action:"run_command",command:"/function veinminer:settings/set {key:$(key),value:0}"}}]
$tellraw @s ["",{text:" $(label): ",color:"gray",hover_event:{action:"show_text",value:"$(hint)"}},{text:"[OFF]",color:"red",hover_event:{action:"show_text",value:"Click to turn on"},click_event:{action:"run_command",command:"/function veinminer:settings/set {key:$(key),value:1}"}}]
